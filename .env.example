# Required
SECRET_KEY=generate-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-unique-password
APP_ENV=development

# Production database. Leave the SQLite default only for local development.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Production rate-limit storage. Use a shared Redis/Valkey service with TLS.
# RATELIMIT_STORAGE_URI=rediss://username:password@redis.example.com:6379/0
# TRUSTED_PROXY_HOPS=1

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# TextBee SMS settings
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=your-textbee-device-id

# Optional local settings
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
